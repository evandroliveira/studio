<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia arquivos/pastas sensíveis
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js|README\.md)$ - [F,L,NC]

    # Mantém /storage funcionando quando a raiz do projeto está exposta
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Se o host apontar para a raiz, envia tudo para /public
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
